#standardSQL

-- Step 3a: Aggregate messages into events + regions S2 join + spatial measures
-- This step is INCREMENTAL: only processes events with event_end_date >= boundary
-- Inputs that are stable/immutable: merged messages, regions, spatial measures
-- Does NOT join any mutable dimension tables (segment quality, vessel identity)

{% include 'util.sql.j2' %}


WITH
    --
    -- Read merged table with optional partition elimination for incremental mode
    --
    source_messages AS (
        SELECT *
        FROM `{{ merged_table }}`
        {% if start_date %}
        WHERE event_end_date >= DATE_SUB('{{ start_date }}', INTERVAL 1 DAY)
        {% endif %}
    ),

    --
    -- Compute geography point per message
    --
    messages_with_point AS (
        SELECT *, SAFE.ST_GEOGPOINT(lon, lat) AS point
        FROM source_messages
    ),

    --
    -- Aggregate all messages in the same event into a single event record
    -- Filter out short events or events where vessel is moving too fast
    -- GROUP BY (ssvid, seg_id, event_start) -- no vessel_id, no dimension joins
    --
    fishing_event AS (
        SELECT
            ssvid,
            seg_id,
            ST_CENTROID(ST_UNION_AGG(point)) AS centroid,
            ARRAY_AGG(STRUCT(point AS point, S2_CELLIDFROMPOINT(point, s2_level()) AS s2_cell)) AS geo_info,
            event_start,
            MAX(timestamp) AS event_end,
            MIN(lat) AS lat_min,
            MAX(lat) AS lat_max,
            MIN(lon) AS lon_min,
            MAX(lon) AS lon_max,
            MIN(anti_lon(lon)) AS anti_lon_min,
            MAX(anti_lon(lon)) AS anti_lon_max,
            COUNT(*) AS message_count,
            AVG(speed_knots) AS avg_speed_knots,
            -- remove first implied_speed_knots value in each event as it comes from previous position
            AVG(CASE WHEN event_start = timestamp THEN NULL
                     ELSE implied_speed_knots END) AS avg_implied_speed_knots,
            -- remove first meters_to_prev value in each event as it comes from previous position
            AVG(CASE WHEN event_start = timestamp THEN NULL
                     ELSE meters_to_prev END) AS avg_meters_to_prev,
            SUM(CASE WHEN event_start = timestamp THEN NULL
                     ELSE meters_to_prev END) AS event_distance_m,
            -- remove first hours value in each event as it comes from previous position
            AVG(CASE WHEN event_start = timestamp THEN NULL
                     ELSE hours END) AS avg_hours,
            STRING_AGG(CONCAT(CAST(lon AS STRING), ' ', CAST(lat AS STRING)), ', ' ORDER BY timestamp) AS points_wkt
        FROM
            messages_with_point
        GROUP BY
            ssvid,
            seg_id,
            event_start
        -- exclude events too short or with too high an avg vessel speed
        HAVING
            -- fishing events must be longer than 20 minutes
            TIMESTAMP_DIFF(event_end, event_start, SECOND) > 1200
            -- fishing events must include more than 5 AIS positions
            AND message_count > 5
            -- event average speed must be less than 10 knots
            AND avg_speed_knots < 10
    ),

    --
    -- Correct lon_min and lon_max for crossing the dateline (anti-meridian)
    -- Extract lat and lon from the centroid
    --
    fishing_event_dateline AS (
        SELECT
            * EXCEPT (centroid, lon_min, lon_max, anti_lon_min, anti_lon_max),
            geopoint_to_struct(centroid).lat AS lat_mean,
            geopoint_to_struct(centroid).lon AS lon_mean,
            IF((lon_max - lon_min) <= (anti_lon_max - anti_lon_min),
                lon_min,
                anti_lon(anti_lon_max)) AS lon_min,
            IF((lon_max - lon_min) <= (anti_lon_max - anti_lon_min),
                lon_max,
                anti_lon(anti_lon_min)) AS lon_max
        FROM fishing_event
    ),

    --
    -- Add event_end_date for partitioning
    --
    events_with_date AS (
        SELECT *, DATE(event_end) AS event_end_date
        FROM fishing_event_dateline
    ),


    --------------------------------------------------------------------------
    -- REGIONS S2 SPATIAL JOIN
    -- Uses immutable reference data (regions, spatial measures)
    -- Keyed by (seg_id, event_start) since event_id is not yet available
    --------------------------------------------------------------------------

    regions_source AS (
        SELECT * FROM `{{ regions_table }}`
    ),

    source_spatial_measures AS (
        SELECT * FROM `{{ spatial_measures_table }}`
    ),

    gridded_regions AS (
        SELECT * EXCEPT(s2_cells)
        FROM regions_source
        CROSS JOIN UNNEST(s2_cells) AS s2_cell
    ),

    -- S2 spatial join: match event message positions to geographic regions
    create_event_region_matches AS (
        SELECT
            event.seg_id,
            event.event_start,
            id,
            layer
        FROM
            events_with_date AS event,
            UNNEST(event.geo_info) geo_info
            JOIN gridded_regions r ON r.s2_cell = geo_info.s2_cell
        WHERE ST_WITHIN(geo_info.point, r.geo)
    ),

    event_by_layer_by_id AS (
        SELECT
            seg_id, event_start, layer, id
        FROM create_event_region_matches
        GROUP BY
            seg_id,
            event_start,
            layer,
            id
    ),

    events_by_layer AS (
        SELECT
            seg_id,
            event_start,
            CONCAT('"', layer, '":', TO_JSON_STRING(ARRAY_AGG(id))) AS json_frament
        FROM event_by_layer_by_id
        GROUP BY
            seg_id,
            event_start,
            layer
    ),

    event_with_region AS (
        SELECT
            seg_id,
            event_start,
            parse_regions_to_struct(CONCAT("{", STRING_AGG(json_frament, ","), "}")) AS regions
        FROM events_by_layer
        GROUP BY
            seg_id,
            event_start
    ),

    -- Join regions back to events
    events_with_regions AS (
        SELECT
            fe.*,
            region_data.regions AS regions_mean_position
        FROM
            events_with_date AS fe
            LEFT JOIN event_with_region AS region_data
                ON region_data.seg_id = fe.seg_id
                AND region_data.event_start = fe.event_start
    ),


    --------------------------------------------------------------------------
    -- SPATIAL MEASURES JOIN
    -- Distance from shore/port at bounding box corners
    --------------------------------------------------------------------------

    final_events AS (
        SELECT
            e.ssvid,
            e.seg_id,
            e.event_start,
            e.event_end,
            e.event_end_date,
            e.lat_mean,
            e.lon_mean,
            e.lat_min,
            e.lat_max,
            e.lon_min,
            e.lon_max,
            e.message_count,
            e.avg_speed_knots,
            e.avg_implied_speed_knots,
            e.avg_meters_to_prev,
            e.event_distance_m,
            e.avg_hours,
            e.points_wkt,
            e.regions_mean_position,
            convert_m_to_km(spatial_measures_start.distance_from_shore_m) AS start_distance_from_shore_km,
            convert_m_to_km(spatial_measures_end.distance_from_shore_m) AS end_distance_from_shore_km,
            convert_m_to_km(spatial_measures_start.distance_from_port_m) AS start_distance_from_port_km,
            convert_m_to_km(spatial_measures_end.distance_from_port_m) AS end_distance_from_port_km
        FROM
            events_with_regions AS e
            JOIN source_spatial_measures AS spatial_measures_start
                ON format_gridcode(e.lon_min, e.lat_min) = spatial_measures_start.gridcode
            JOIN source_spatial_measures AS spatial_measures_end
                ON format_gridcode(e.lon_max, e.lat_max) = spatial_measures_end.gridcode
    )


SELECT * FROM final_events
