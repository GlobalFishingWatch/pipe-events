#standardSQL

-- Step 3b: Filter + vessel identity enrichment
--
-- This step ALWAYS runs as a FULL scan (WRITE_TRUNCATE) because the
-- dimension tables it joins -- segs_activity, segment_vessel,
-- product_vessel_info_summary -- change daily and must use fresh data
-- for ALL events, not just the current day's slice. The input is the
-- event-level `_aggregated` table (produced by step 3a), NOT the
-- message-level `_merged` table -- so the full scan is cheap (one row
-- per event, not one row per AIS message).

{% include 'util.sql.j2' %}


WITH
    source_segs AS (
        SELECT *
        FROM `{{ segs_activity_table }}`
    ),

    source_segment_vessel AS (
        SELECT *
        FROM `{{ segment_vessel_table }}`
    ),

    -- Fishing-vessel candidate set. Mirrors current main's step-3 filter
    -- (`prod_shiptype='fishing' OR ((is_fishing(registry_geartype) OR
    -- on_fishing_list_nn OR on_fishing_list_sr) AND
    -- shipname_indicates_likely_gear = FALSE)`) so the rebased refactor
    -- produces the same candidate set as main; any output difference
    -- attributed to the refactor is a step-4-shape difference, not a
    -- filter-shape difference.
    source_fishing_vessels AS (
        SELECT *
        FROM `{{ product_vessel_info_summary_table }}`
        WHERE
            prod_shiptype = 'fishing'
            OR ((`{{ udfs_dataset }}`.is_fishing(registry_geartype) IS TRUE
                OR on_fishing_list_nn = TRUE
                OR on_fishing_list_sr = TRUE)
                AND shipname_indicates_likely_gear = FALSE)
    ),

    --
    -- Filter aggregated events to only those from good segments
    --
    aggregated_good_segments AS (
        SELECT * FROM `{{ aggregated_table }}`
        WHERE seg_id IN (
            SELECT seg_id
            FROM source_segs
            WHERE
                good_seg
                AND positions > 10
                AND NOT overlapping_and_short
        )
    ),

    --
    -- Get a vessel_id for each segment
    --
    best_segment_vessel AS (
        SELECT DISTINCT
            seg_id,
            FIRST_VALUE(vessel_id) OVER (
                PARTITION BY seg_id ORDER BY last_date DESC, vessel_id
            ) AS vessel_id
        FROM source_segment_vessel
    ),

    --
    -- Join vessel_id to events
    --
    events_with_vessel_id AS (
        SELECT fe.*, bsv.vessel_id
        FROM aggregated_good_segments fe
        INNER JOIN best_segment_vessel bsv USING(seg_id)
    ),

    --
    -- Join vessel identity information.
    -- LEFT JOIN: if vessel is not in the fishing-vessel candidate set,
    -- identity fields are NULL and vessel_class ends up NULL, which the
    -- vessel-class filter below drops (both branches require a specific
    -- best_best_vessel_class value).
    --
    -- The PVIS field-prefix (`ais_` on AIS PVIS, empty on VMS PVIS) is
    -- resolved via the wrapper's --product-vessel-info-summary-field-prefix
    -- CLI arg, matching current main's step-3 shape.
    --
    -- INTENTIONAL SEMANTIC CHANGE vs pre-refactor main:
    --
    -- Pre-refactor step 3 joined PVIS BEFORE message-level aggregation
    -- on the per-message ``year`` column, and carried the identity
    -- fields into the GROUP BY. For an event whose messages spanned a
    -- calendar-year boundary and whose PVIS row differed between the two
    -- years (vessel re-registered, geartype reclassification, etc.), that
    -- produced TWO event rows -- one per year fragment. HAVING clauses
    -- like ``message_count > 5`` were then applied to each fragment
    -- independently, so a fragment with <=5 messages was dropped. In the
    -- pathological case where PVIS has a row for the SECOND year only,
    -- ``EXTRACT(YEAR FROM event_start)`` on the FIRST year would resolve
    -- to NULL identity and the event would be dropped entirely, where
    -- pre-refactor kept the (matching) second-year fragment.
    --
    -- The refactor's aggregation is by (ssvid, seg_id, event_start) only
    -- and PVIS identity is resolved ONCE per event via
    -- ``EXTRACT(YEAR FROM event_start)``. Events crossing a year boundary
    -- are no longer shredded; per-message-year identity differences are
    -- collapsed to the event-start year. This is the RIGHT semantics --
    -- an event shouldn't be split because a dimension table is keyed by
    -- calendar year -- but it IS a behavioural change: the E5
    -- cross-version smoke will report a diff on the specific subset of
    -- year-spanning events with year-dependent PVIS rows. Documented
    -- explicitly in the PR description with a characterisation query.
    --
    events_with_identity AS (
        SELECT
            e.* EXCEPT(vessel_id),
            vesselinfo.vessel_id,
            vesselinfo.prod_geartype AS best_best_vessel_class,
            vesselinfo.ssvid AS main_vessel_ssvid,
            vesselinfo.{{ product_vessel_info_summary_field_prefix }}mmsi_flag AS main_vessel_flag,
            vesselinfo.{{ product_vessel_info_summary_field_prefix }}shipname AS main_vessel_shipname
        FROM
            events_with_vessel_id e
            LEFT JOIN source_fishing_vessels AS vesselinfo
                ON e.vessel_id = vesselinfo.vessel_id
                AND EXTRACT(YEAR FROM e.event_start) = vesselinfo.year
    ),

    --
    -- Apply vessel-class filter and generate event_id.
    --   nnet_score:      exclude squid jiggers, require >500m distance
    --   night_loitering: only squid jiggers,    require >50m distance
    --
    complete_fishing_event AS (
        SELECT
            *,
            TO_HEX(MD5(FORMAT(
                "%s|%s|%t|%t", 'fishing', vessel_id, event_start, event_end
            ))) AS event_id
        FROM events_with_identity
        WHERE
            ('{{ nnet_score_night_loitering }}' = 'nnet_score'
                AND NOT best_best_vessel_class = 'squid_jigger'
                AND event_distance_m > 500)
            OR
            ('{{ nnet_score_night_loitering }}' != 'nnet_score'
                AND best_best_vessel_class = 'squid_jigger'
                AND event_distance_m > 50)
    )

SELECT * FROM complete_fishing_event
