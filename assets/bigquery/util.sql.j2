#standardSQL

# Utility Functions

# Validate SSVID
# Returns NULL if the SSVID is valid (64 characters), otherwise returns the original SSVID
# This is useful for filtering out VMS ssvids
# more context here: https://github.com/GlobalFishingWatch/pipe-events/pull/135
CREATE TEMPORARY FUNCTION filter_invalid_ssvid( ssvid STRING )
AS (
  IF (LENGTH(ssvid) = 64, NULL, ssvid)
);

# Get the longitude of the antipode for a given longitude
#
# This funtion transforms the longitude to the meridian on the opposite side of the world
# This is useful for doing operations with data that spans the anti-meridian
#
# Apply the function again to the transformed value to return to the original meridian
#
# Example
#   anti_lon(0.0) = 0.0
#   anti_lon(90.0) = -90.0
#   anti_lon(-90.0) = 90.0
#   anti_lon(-179.0) = 1.0
#   anti_lon(1.0) = -179.0
#
CREATE TEMPORARY FUNCTION anti_lon ( lon FLOAT64 )
AS (
  IF (lon < 0, 180.0 + lon, (180 - lon) * -1)
);


# Convert a lat,lon pont in a GEOGRAPHY, such as created with ST_GEOGPOINT(lon, lat)
# Retrns a STRUCT(lon, lat)
#
# It seems ridiculous that we have to convert to json and then parse it to do this, but bigquery
# does not provide any other way to get the lat/lon out of a GEOGRAPHY

CREATE TEMPORARY FUNCTION geopoint_to_struct (pt GEOGRAPHY)
AS (
  STRUCT(
    CAST(JSON_EXTRACT_SCALAR(ST_ASGEOJSON(pt), "$['coordinates'][0]") AS FLOAT64) as lon,
    CAST(JSON_EXTRACT_SCALAR(ST_ASGEOJSON(pt), "$['coordinates'][1]") AS FLOAT64) as lat
  )
);

# Format gridcode
# Generate gridcode from lon and lat
# Returns a String
#
# The new spatial measures table uses a different cell alignment: grid cells are
# keyed by their FLOOR edge, not the ROUND/mean of the cell. So we must derive the
# gridcode with FLOOR to match it. Casting to NUMERIC against a NUMERIC 0.01 grid
# keeps the math deterministic (no float division drift). Flooring toward -inf also
# means the only zero result comes from lon/lat in [0, 0.01), so no "-0.00" appears.

CREATE TEMPORARY FUNCTION format_gridcode (lon FLOAT64, lat FLOAT64) AS (
    FORMAT("lon:%+07.2f_lat:%+07.2f",
        FLOOR(CAST(lon AS NUMERIC) / NUMERIC '0.01') * NUMERIC '0.01',
        FLOOR(CAST(lat AS NUMERIC) / NUMERIC '0.01') * NUMERIC '0.01')
);

# Convert meters to kilometers
# Returns a Float
CREATE TEMPORARY FUNCTION convert_m_to_km (m FLOAT64) AS (m / 1000);

# Convert nautical miles to kilometers
# Returns a Float
CREATE TEMPORARY FUNCTION convert_nm_to_km (nm FLOAT64) as (nm * 1.852);

--
-- Creates a port-id based in the iso3 and the label of the port
--
CREATE TEMPORARY FUNCTION
  generate_port_id (iso3 STRING,
    label STRING) AS ( LOWER(CONCAT(iso3,"-",REGEXP_REPLACE(NORMALIZE(label),' ',''))) );

-- Returns true an rfmo is whitelisted so that authorizations should be
-- computed for it
    CREATE TEMPORARY FUNCTION is_whitelisted_rfmo(rfmo STRING) AS ( rfmo IN (
          "ICCAT",
          "IOTC",
          "WCPFC",
          "IATTC",
          "CCSBT",
          "SPRFMO",
          "NPFC" )
     );

CREATE TEMP FUNCTION s2_level() AS (10);

# Normalise decimal hours into the [0, 24) range after applying a longitude offset.
CREATE TEMP FUNCTION wrap_hours(hours FLOAT64) AS (
  CASE
    WHEN hours < 0 THEN hours + 24
    WHEN hours >= 24 THEN hours - 24
    ELSE hours
  END
);

# Extract the time component of a UTC timestamp as decimal hours.
CREATE TEMP FUNCTION utc_decimal_hours(t TIMESTAMP) AS (
  EXTRACT(HOUR FROM t) + EXTRACT(MINUTE FROM t) / 60.0 + EXTRACT(SECOND FROM t) / 3600.0
);

-- The set of regions is dynamic (sourced from pipe-regions' own registry -- see
-- pipe_events.utils.regions.fetch_regions_registry), not hardcoded here, so this struct's
-- fields always match whatever regions are currently registered, instead of silently drifting
-- out of sync with them. `|default([])`: util.sql.j2 is included by every event query, but only
-- some of them actually call this function -- the others never pass a `regions` var at all, and
-- this repo's Jinja environment is StrictUndefined, so referencing it unconditionally would
-- break rendering for those.
CREATE TEMP FUNCTION parse_regions_to_struct(regions_str STRING)
  RETURNS STRUCT<{% for region in regions|default([]) %}{{ region }} ARRAY<STRING>{% if not loop.last %}, {% endif %}{% endfor %}>
  LANGUAGE js AS
"""
    const regions = JSON.parse(regions_str)
{% for region in regions|default([]) %}    this.{{ region }} = regions.{{ region }} || [];
{% endfor %}    return this;
""";
